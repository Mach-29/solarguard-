# ── SolarGuard environment configuration ──
# Copy this file to .env and fill in your values.

# ── SMTP / Email (Gmail example — use an App Password, not your normal password) ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=alerts@yourcompany.com
SMTP_PASSWORD=your-gmail-app-password
ALERT_FROM_EMAIL=alerts@yourcompany.com

# ── Monitoring thresholds ──
DEFAULT_DROP_THRESHOLD=0.10   # Alert when output drops >10% below expected
EXPECTED_LOOKBACK_DAYS=14     # Use last 14 days as baseline
